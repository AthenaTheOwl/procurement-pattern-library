{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vignesh/procurement-pattern-library/schemas/pattern.schema.json",
  "title": "Pattern front-matter",
  "type": "object",
  "required": ["id", "name", "canonical_statement", "domains", "created_at", "applications_dir"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase kebab-case identifier; matches the filename stem."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "canonical_statement": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence plain-assertion statement of the pattern."
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["procurement", "supply-chain", "mechanism-design", "ai-build"]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "applications_dir": {
      "type": "string",
      "const": "applications/"
    }
  }
}
