{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vignesh/procurement-pattern-library/schemas/case.schema.json",
  "title": "Application case front-matter",
  "type": "object",
  "required": ["id", "pattern_id", "domain", "upstream_artifact", "opened_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "domain": {
      "type": "string",
      "enum": ["procurement", "supply-chain", "mechanism-design", "ai-build"]
    },
    "upstream_artifact": {
      "type": "string",
      "pattern": "^(repo://|file://|https://)"
    },
    "opened_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": [
        "transferred-cleanly",
        "transferred-with-friction",
        "did-not-transfer",
        "still-pending",
        null
      ]
    },
    "expected_mechanism": {
      "type": "string",
      "minLength": 1,
      "description": "Optional, written before the outcome is known: why the pattern should transfer."
    },
    "failure_context": {
      "type": "string",
      "minLength": 1,
      "description": "Optional: the context where the transfer is expected to break."
    },
    "disconfirming_result": {
      "type": "string",
      "minLength": 1,
      "description": "Optional: an observable result that would show the transfer failed."
    },
    "observation_window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "description": "Optional: planned observation window, inside the ninety-day outcome rule (DEC-PPL-001)."
    }
  }
}
